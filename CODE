<!-- FIREBASE CLOUD DATABASE INTEGRATION -->
<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.4.0/firebase-app.js";
    import { getDatabase, ref, set, onValue, push } from "https://www.gstatic.com/firebasejs/10.4.0/firebase-database.js";

    const firebaseConfig = {
      apiKey: "AIzaSyCOPBby4IBRYlNfXXi6QNZCT8HXJrdC3X8",
      authDomain: "chair-we-go.firebaseapp.com",
      databaseURL: "https://chair-we-go-default-rtdb.asia-southeast1.firebasedatabase.app",
      projectId: "chair-we-go",
      storageBucket: "chair-we-go.firebasestorage.app",
      messagingSenderId: "439637769749",
      appId: "1:439637769749:web:0a71b7c7aedbb9222ad81c"
    };

    const app = initializeApp(firebaseConfig);
    const db = getDatabase(app);

    async function hashPassword(password) {
        const msgUint8 = new TextEncoder().encode(password);
        const hashBuffer = await crypto.subtle.digest('SHA-256', msgUint8);
        const hashArray = Array.from(new Uint8Array(hashBuffer));
        return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
    }

    const defaultUsers = [ { name: "admin", email: "admin@chairwego.com", pass: "8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918", role: "admin" } ];
    const defaultInventory = [
        { id: 1, name: "Premium Monoblock", desc: "Classic white stackable seating. Impeccably clean, lightweight, and sturdy.", stock: 150, price: 15.00, coverFee: 5, img: "images/monoblock.jpg" },
        { id: 2, name: "Round Banquet Table", desc: "60-inch diameter elegant table. Comfortably seats 6-8 guests.", stock: 30, price: 120.00, coverFee: 25, img: "images/round-table.jpg" },
        { id: 3, name: "Rectangular Buffet Table", desc: "72x30 inches. Perfect for 8-10 guests or long buffet stylings.", stock: 35, price: 150.00, coverFee: 40, img: "images/rect-table.jpg" }
    ];

    let usersDb = defaultUsers;
    let inventory = defaultInventory;
    let allReservations = [];
    let bookingsDb = {};
    let globalChats = {};

    let cart = [];
    let loginAttempts = 0;
    let currentUser = null;
    let currentUserEmail = null;
    let selectedEventDate = null;
    let selectedAddress = null;
    let selectedDeliveryFee = 0;
    let selectedLogistics = "";
    let selectedPaymentMode = "";
    let pendingCartAction = null;
    let calDate = new Date();
    
    let activeChatUser = null;
    let previousChatCount = 0;
    let isChatOpen = false;

    function showToast(message) {
        const container = document.getElementById("toast-container");
        const toast = document.createElement("div");
        toast.className = "toast";
        toast.innerHTML = `<span>${message}</span> <button style="background:transparent; border:none; color:white; width:auto; padding:0; font-size:1.2em; cursor:pointer;" onclick="this.parentElement.remove()">×</button>`;
        container.appendChild(toast);
        setTimeout(() => { if(toast.parentElement) toast.remove(); }, 5000);
    }

    onValue(ref(db, '/'), (snapshot) => {
        const data = snapshot.val();
        if (data) {
            usersDb = data.users ? (Array.isArray(data.users) ? data.users : Object.values(data.users)) : defaultUsers;
            inventory = data.inventory ? (Array.isArray(data.inventory) ? data.inventory : Object.values(data.inventory)) : defaultInventory;
            
            const newRes = data.reservations ? (Array.isArray(data.reservations) ? data.reservations : Object.values(data.reservations)) : [];
            if (currentUser === "admin" && newRes.length > allReservations.length && allReservations.length > 0) {
                showToast("🛎️ New reservation received!");
            }
            allReservations = newRes;
            bookingsDb = data.bookings || {};
            
            globalChats = data.chats || {};
            processChatUpdates();

        } else {
            saveData();
        }

        if (currentUser === "admin") {
            if(document.getElementById('admin-inventory').classList.contains('active-view')) renderAdminInventory();
            if(document.getElementById('admin-renters').classList.contains('active-view')) renderRentersList();
            if(document.getElementById('admin-calendar').classList.contains('active-view')) renderCalendar();
        }
    });

    function saveData() {
        set(ref(db, '/'), {
            users: usersDb,
            inventory: inventory,
            reservations: allReservations,
            bookings: bookingsDb,
            chats: globalChats
        });
    }

    // -- Chat Logic --
    function toggleChatWidget() {
        const widget = document.getElementById("chat-widget");
        isChatOpen = !isChatOpen;
        widget.style.display = isChatOpen ? "flex" : "none";
        if(isChatOpen) renderChatUI();
    }

    function processChatUpdates() {
        if(!currentUser) return;
        
        let currentTotalMessages = 0;
        let incomingUnread = false;

        if (currentUser === "admin") {
            Object.keys(globalChats).forEach(user => {
                const userMsgs = Object.values(globalChats[user]);
                currentTotalMessages += userMsgs.length;
                if(userMsgs.length > 0 && userMsgs[userMsgs.length-1].sender !== "admin") {
                    incomingUnread = true;
                }
            });
        } else {
            if(globalChats[currentUser]) {
                const myMsgs = Object.values(globalChats[currentUser]);
                currentTotalMessages = myMsgs.length;
                if(myMsgs.length > 0 && myMsgs[myMsgs.length-1].sender === "admin") {
                    incomingUnread = true;
                }
            }
        }

        if (currentTotalMessages > previousChatCount) {
            if (!isChatOpen && incomingUnread) {
                showToast("💬 New chat message received!");
            }
            previousChatCount = currentTotalMessages;
            if(isChatOpen) renderChatUI();
        }
    }

    function renderChatUI() {
        if(currentUser === "admin") {
            document.getElementById("admin-chat-list").style.display = "block";
            const listDiv = document.getElementById("admin-chat-list");
            listDiv.innerHTML = "";
            const activeUsers = Object.keys(globalChats);
            
            if(activeUsers.length === 0) listDiv.innerHTML = "<div style='padding:10px; font-size:0.8em; color:var(--text-light);'>No active chats.</div>";
            
            activeUsers.forEach(user => {
                const userMsgs = Object.values(globalChats[user]);
                const lastMsg = userMsgs[userMsgs.length-1];
                const isUnread = (lastMsg.sender !== "admin");
                
                const div = document.createElement("div");
                div.className = `chat-list-user ${activeChatUser === user ? 'active' : ''} ${isUnread ? 'unread' : ''}`;
                div.innerText = user;
                div.onclick = () => { activeChatUser = user; renderChatUI(); };
                listDiv.appendChild(div);
            });

            if(!activeChatUser && activeUsers.length > 0) activeChatUser = activeUsers[0];
            document.getElementById("chat-title").innerText = activeChatUser ? `Chat: ${activeChatUser}` : "Select a client";
            
        } else {
            document.getElementById("admin-chat-list").style.display = "none";
            document.getElementById("chat-title").innerText = "Support Chat";
            activeChatUser = currentUser;
        }

        renderMessages();
    }

    function renderMessages() {
        const msgDiv = document.getElementById("chat-messages");
        msgDiv.innerHTML = "";
        if(!activeChatUser || !globalChats[activeChatUser]) return;
        
        Object.values(globalChats[activeChatUser]).forEach(msg => {
            const div = document.createElement("div");
            div.className = "msg-bubble " + (msg.sender === currentUser ? "msg-admin" : "msg-client");
            
            let html = "";
            if (msg.text) {
                const textDiv = document.createElement("div");
                textDiv.innerText = msg.text;
                html += textDiv.outerHTML;
            }
            if (msg.image) {
                html += `<a href="${msg.image}" target="_blank" title="Click to view full image"><img src="${msg.image}" style="max-width:100%; border-radius:8px; margin-top:5px; display:block; cursor:pointer;" alt="Proof Attachment"></a>`;
            }
            div.innerHTML = html;
            msgDiv.appendChild(div);
        });
        msgDiv.scrollTop = msgDiv.scrollHeight;
    }

    async function sendChatMessage() {
        const input = document.getElementById("chat-input");
        const text = input.value.trim();
        if(!text || !activeChatUser) return;

        const chatRef = ref(db, `chats/${activeChatUser}`);
        await push(chatRef, { sender: currentUser, text: text, timestamp: Date.now() });
        input.value = "";
    }

    async function sendChatImage(event) {
        const file = event.target.files[0];
        if (!file || !activeChatUser) return;

        if (!file.type.startsWith('image/')) {
            alert("Please select a valid image file.");
            return;
        }

        if (file.size > 2 * 1024 * 1024) {
            alert("Image file is too large. Please upload an image under 2MB.");
            return;
        }

        const reader = new FileReader();
        reader.onload = async function(e) {
            const base64Image = e.target.result;
            const chatRef = ref(db, `chats/${activeChatUser}`);
            await push(chatRef, { 
                sender: currentUser, 
                text: "📷 Sent proof/attachment:", 
                image: base64Image, 
                timestamp: Date.now() 
            });
            event.target.value = "";
        };
        reader.readAsDataURL(file);
    }

    function handleChatEnter(e) { if(e.key === "Enter") sendChatMessage(); }

    // -- App Logic --
    let minDate = new Date();
    minDate.setDate(minDate.getDate() + 4);
    document.getElementById('reservation-date').min = minDate.toISOString().split("T")[0];

    function showSection(id) {
        document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
        document.getElementById(id).classList.add('active');
    }

    function goHome() {
        if(currentUser) return; 
        showSection('landing-section');
    }

    function getStarted(type) {
        showSection('auth-section');
        switchAuth(type);
    }

    function switchAuth(type) {
        document.getElementById("login-msg").innerText = ""; document.getElementById("signup-msg").innerText = "";
        document.getElementById("signup-name").value = ""; document.getElementById("signup-email").value = ""; 
        document.getElementById("signup-pass").value = "";
        document.getElementById("login-identifier").value = ""; document.getElementById("login-pass").value = "";
        document.getElementById("login-view").style.display = type === 'login' ? "block" : "none";
        document.getElementById("signup-view").style.display = type === 'signup' ? "block" : "none";
    }

    async function signup() {
        const name = document.getElementById("signup-name").value.trim();
        const email = document.getElementById("signup-email").value.trim();
        const pass = document.getElementById("signup-pass").value;
        const msg = document.getElementById("signup-msg");
        
        msg.classList.remove("success");
        if(!name || !email || !pass) return msg.innerText = "Please provide Name, Email, and Password.";
        
        if(!email.includes("@")) return msg.innerText = "Please provide a valid email address.";

        if(usersDb.find(u => u.name.toLowerCase() === name.toLowerCase() || (u.email && u.email.toLowerCase() === email.toLowerCase()))) {
            return msg.innerText = "Name or Email is already registered.";
        }
        
        const securedPassword = await hashPassword(pass);
        
        usersDb.push({ name: name, email: email, pass: securedPassword, role: "user" });
        saveData();
        
        msg.classList.add("success"); msg.innerText = "Account created! Redirecting...";
        setTimeout(() => switchAuth('login'), 1500);
    }

    async function login() {
        const msg = document.getElementById("login-msg"); msg.classList.remove("success");
        const lockedUntil = localStorage.getItem("lockoutTime");
        if (lockedUntil && Date.now() < lockedUntil) return msg.innerText = `Suspended. Try again in ${Math.ceil((lockedUntil - Date.now()) / 1000)}s.`;
        
        const identifier = document.getElementById("login-identifier").value.trim();
        const passInput = document.getElementById("login-pass").value;
        const hashedInput = await hashPassword(passInput);
        
        // Allows login using either Name OR Email
        const userFound = usersDb.find(u => 
            (u.name.toLowerCase() === identifier.toLowerCase() || 
            (u.email && u.email.toLowerCase() === identifier.toLowerCase())) 
            && u.pass === hashedInput
        );

        if (userFound) {
            loginAttempts = 0; 
            currentUser = userFound.name;
            currentUserEmail = userFound.email || "N/A";
            document.getElementById("chat-toggle-btn").style.display = "flex";
            
            if (userFound.role === "admin") {
                switchAdminTab('inventory');
                showSection("admin-section");
            } else {
                document.getElementById("display-renter-name").innerText = userFound.name;
                renderUser(); showSection("user-section");
            }
        } else {
            if (++loginAttempts >= 3) { localStorage.setItem("lockoutTime", Date.now() + 60000); msg.innerText = "Too many failed attempts. Suspended for 1 minute."; } 
            else msg.innerText = `Invalid credentials. Attempts left: ${3 - loginAttempts}`;
        }
    }

    function logout() { 
        currentUser = null; currentUserEmail = null; cart = []; updateCartCount(); 
        document.getElementById("chat-toggle-btn").style.display = "none";
        document.getElementById("chat-widget").style.display = "none";
        isChatOpen = false;
        showSection("landing-section"); 
    }

    function switchAdminTab(tabName) {
        document.querySelectorAll('.admin-tab-btn').forEach(btn => btn.classList.remove('active-tab'));
        document.getElementById('tab-' + tabName).classList.add('active-tab');
        document.querySelectorAll('.admin-view').forEach(view => view.classList.remove('active-view'));
        document.getElementById('admin-' + tabName).classList.add('active-view');

        if(tabName === 'inventory') renderAdminInventory();
        if(tabName === 'renters') renderRentersList();
        if(tabName === 'calendar') renderCalendar();
    }

    function renderAdminInventory() {
        const tbody = document.querySelector("#inventory-table tbody"); tbody.innerHTML = "";
        inventory.forEach(item => {
            tbody.innerHTML += `<tr><td><strong>${item.name}</strong></td><td><span style="font-size:0.9em; color:var(--text-light);">${item.desc}</span></td><td><strong>${item.stock}</strong></td><td>₱${item.price.toFixed(2)}</td></tr>`;
        });
    }

    function addStock() {
        const name = document.getElementById("add-name").value.trim(), qty = parseInt(document.getElementById("add-qty").value);
        if (!name || isNaN(qty) || qty <= 0) return alert("Enter valid product name and positive quantity.");
        const item = inventory.find(i => i.name.toLowerCase() === name.toLowerCase());
        if (item) { 
            item.stock += qty; 
            saveData(); 
            showToast(`✅ ${item.name} stock updated to ${item.stock}.`);
        } 
        else alert("Rental Item not found. Please type the exact name.");
        document.getElementById("add-name").value = ""; document.getElementById("add-qty").value = "";
        renderAdminInventory();
    }

    function renderRentersList() {
        const tbody = document.querySelector("#renters-table tbody"); tbody.innerHTML = "";
        let renterMap = {};
        allReservations.forEach(res => {
            if(!renterMap[res.renter]) renterMap[res.renter] = [];
            renterMap[res.renter].push(res);
        });

        if(Object.keys(renterMap).length === 0) return tbody.innerHTML = "<tr><td colspan='3'>No reservations found.</td></tr>";

        for (const [renterName, resArray] of Object.entries(renterMap)) {
            tbody.innerHTML += `<tr>
                <td><strong>${renterName}</strong></td>
                <td>${resArray.length} Reservation(s)</td>
                <td><button class="btn-outline btn-small" onclick="showRenterDetails('${renterName}')">View Records</button></td>
            </tr>`;
        }
    }

    function showRenterDetails(renterName) {
        const userRes = allReservations.filter(r => r.renter === renterName);
        let html = "";
        userRes.forEach(res => {
            let statusClass = res.status === "Paid" ? "status-paid" : "status-pending";
            html += `<div class="detail-box">
                <span class="status-badge ${statusClass}">${res.status}</span>
                <p style="margin:5px 0;"><strong>Event Date:</strong> ${res.date}</p>
                <p style="margin:5px 0;"><strong>Logistics:</strong> ${res.logistics}</p>
                <p style="margin:5px 0;"><strong>Venue:</strong> ${res.address || "N/A (Pick-up)"}</p>
                <p style="margin:5px 0;"><strong>Payment Mode:</strong> ${res.paymentMode}</p>
                <p style="margin:5px 0;"><strong>Total Bill:</strong> ₱${res.total.toFixed(2)}</p>
                <ul style="margin:8px 0 0 0; padding-left:20px; font-size:0.95em; color:var(--text-light);">`;
            res.items.forEach(i => html += `<li>${i.qty}x ${i.name}</li>`);
            html += `</ul></div>`;
        });
        document.getElementById("modal-title").innerText = `Client Records: ${renterName}`;
        document.getElementById("modal-body").innerHTML = html;
        document.getElementById("admin-detail-modal").style.display = "flex";
    }

    function changeAdminResStatus(id, dateStr, newStatus) {
        let res = allReservations.find(r => r.id === id);
        if(res) {
            res.status = newStatus;
            saveData();
            showDateDetails(dateStr); 
            showToast("Payment status updated.");
        }
    }

    function deleteAdminReservation(id, dateStr) {
        if(!confirm("Are you sure you want to terminate this reservation? This will free the inventory globally.")) return;
        
        let res = allReservations.find(r => r.id === id);
        if(res && bookingsDb[dateStr]) {
            res.items.forEach(i => {
                if(bookingsDb[dateStr][i.originalId]) {
                    bookingsDb[dateStr][i.originalId] -= i.qty;
                    if(bookingsDb[dateStr][i.originalId] < 0) bookingsDb[dateStr][i.originalId] = 0;
                }
            });
        }
        
        allReservations = allReservations.filter(r => r.id !== id);
        saveData(); 
        showToast("Reservation terminated. Inventory freed.");
        
        showDateDetails(dateStr); 
        renderCalendar(); 
        renderRentersList();
    }

    function renderCalendar() {
        const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
        document.getElementById("cal-month-year").innerText = `${monthNames[calDate.getMonth()]} ${calDate.getFullYear()}`;
        
        const grid = document.getElementById("cal-grid"); grid.innerHTML = "";
        let firstDayIndex = new Date(calDate.getFullYear(), calDate.getMonth(), 1).getDay();
        let daysInMonth = new Date(calDate.getFullYear(), calDate.getMonth() + 1, 0).getDate();

        for(let i = 0; i < firstDayIndex; i++) grid.innerHTML += `<div class="cal-cell empty"></div>`;

        for(let d = 1; d <= daysInMonth; d++) {
            let m = (calDate.getMonth() + 1).toString().padStart(2, '0');
            let dayStr = d.toString().padStart(2, '0');
            let fullDateStr = `${calDate.getFullYear()}-${m}-${dayStr}`;

            let dailyRes = allReservations.filter(r => r.date === fullDateStr);
            let hasBookingClass = dailyRes.length > 0 ? "has-booking" : "";
            let badgeHtml = dailyRes.length > 0 ? `<span class="booking-badge">${dailyRes.length}</span>` : "";

            grid.innerHTML += `<div class="cal-cell ${hasBookingClass}" onclick="showDateDetails('${fullDateStr}')">
                ${badgeHtml} ${d}
            </div>`;
        }
    }

    function changeMonth(dir) { calDate.setMonth(calDate.getMonth() + dir); renderCalendar(); }

    function showDateDetails(dateStr) {
        const dayRes = allReservations.filter(r => r.date === dateStr);
        if(dayRes.length === 0) {
            document.getElementById("admin-detail-modal").style.display = "none";
            return alert("No events booked for this date.");
        }
        
        let html = "";
        dayRes.forEach(res => {
            let statusClass = res.status === "Paid" ? "status-paid" : "status-pending";
            html += `<div class="detail-box" style="position:relative; padding-top: 45px;">
                <div style="position:absolute; right:15px; top:15px; display:flex; gap:10px;">
                    ${res.status !== "Paid" ? `<button onclick="changeAdminResStatus(${res.id}, '${dateStr}', 'Paid')" style="background:var(--success); color:white; border:none; padding:5px 12px; border-radius:15px; cursor:pointer; font-size:0.8em; font-weight: 500;">Mark Paid</button>` : ''}
                    <button onclick="deleteAdminReservation(${res.id}, '${dateStr}')" style="background:var(--danger); color:white; border:none; padding:5px 12px; border-radius:15px; cursor:pointer; font-size:0.8em; font-weight: 500;">Terminate</button>
                </div>
                
                <span class="status-badge ${statusClass}" style="position:absolute; left:15px; top:15px; margin:0;">${res.status}</span>
                <p style="margin:10px 0 5px 0; color:var(--primary); font-size: 1.1em; font-weight: 500;"><strong>Client:</strong> ${res.renter}</p>
                <p style="margin:0 0 5px 0; font-size:0.95em;"><strong>Logistics:</strong> ${res.logistics} | <strong>Payment Mode:</strong> ${res.paymentMode}</p>
                <p style="margin:0 0 5px 0; font-size:0.95em;"><strong>Venue:</strong> ${res.address || "N/A (Pick-up)"}</p>
                <p style="margin:0 0 10px 0; font-size:0.95em;"><strong>Bill Total:</strong> ₱${res.total.toFixed(2)}</p>
                
                <ul style="margin:0; padding-left:20px; font-size:0.95em; color:var(--text-light);">`;
            res.items.forEach(i => html += `<li>${i.qty}x ${i.name}</li>`);
            html += `</ul></div>`;
        });
        document.getElementById("modal-title").innerText = `Schedule for ${dateStr}`;
        document.getElementById("modal-body").innerHTML = html;
        document.getElementById("admin-detail-modal").style.display = "flex";
    }

    function closeAdminModal() { document.getElementById("admin-detail-modal").style.display = "none"; }

    function renderUser() {
        const grid = document.getElementById("product-grid"); grid.innerHTML = "";
        inventory.forEach(item => {
            grid.innerHTML += `<div class="card">
                <img src="${item.img}" alt="${item.name}">
                <div class="card-content">
                    <h3>${item.name}</h3>
                    <p class="item-desc">
                        ${item.desc}
                        <strong style="color:var(--text-main); display:block; margin-top:10px; font-weight: 500;">Capacity: ${item.stock} units</strong>
                    </p>
                    <span class="price-tag">₱${item.price.toFixed(2)} <span style="font-size:0.7em; font-family:'Poppins', sans-serif; font-weight:400; color:var(--text-light)">/ day</span></span>
                    <div style="display:flex; gap:10px; align-items:center;">
                        <input type="number" id="qty-${item.id}" min="1" max="${item.stock}" value="1" style="width: 70px; margin:0; padding:10px; text-align:center;">
                        <button onclick="triggerCoverModal(${item.id})" style="flex:1; margin:0;">Reserve Selection</button>
                    </div>
                </div>
            </div>`;
        });
    }

    function triggerCoverModal(id) {
        const item = inventory.find(i => i.id === id); 
        const qtyInput = document.getElementById(`qty-${id}`); 
        const qty = parseInt(qtyInput.value);
        
        if (qty <= 0 || isNaN(qty)) return alert("Please enter a valid quantity.");
        if (qty > item.stock) return alert(`Our current global capacity is ${item.stock} for this item.`);

        pendingCartAction = { item: item, qty: qty, inputRef: qtyInput };
        document.getElementById("cover-modal-text").innerText = `Enhance your seating with elegant fitted covers for ${item.name} at just ₱${item.coverFee} extra per item?`;
        document.getElementById("cover-modal").style.display = "flex";
    }

    function resolveCover(wantsCover) {
        document.getElementById("cover-modal").style.display = "none"; 
        if(!pendingCartAction) return;

        const { item, qty, inputRef } = pendingCartAction;
        const finalPrice = wantsCover ? item.price + item.coverFee : item.price;
        const finalName = wantsCover ? `${item.name} (with Cover)` : item.name;
        const cartId = item.id + (wantsCover ? '-cover' : '-nocover');

        const existing = cart.find(c => c.cartId === cartId);
        if (existing) existing.qty += qty; 
        else cart.push({ cartId: cartId, originalId: item.id, name: finalName, price: finalPrice, qty: qty });

        inputRef.value = 1; 
        pendingCartAction = null; 
        updateCartCount(); 
        showToast(`🛒 Added ${qty}x ${finalName} to your cart.`);
    }

    function updateCartCount() { document.getElementById("cart-count").innerText = cart.reduce((sum, item) => sum + item.qty, 0); }

    function viewCart() {
        const tbody = document.querySelector("#cart-table tbody"); tbody.innerHTML = ""; let subtotal = 0;
        cart.forEach(item => {
            let lineTotal = item.qty * item.price; subtotal += lineTotal;
            tbody.innerHTML += `<tr>
                <td><strong style="color:var(--secondary);">${item.name}</strong></td>
                <td>
                    <div style="display:flex; align-items:center; gap:5px;">
                        <button class="btn-qty" onclick="changeCartQty('${item.cartId}', -1)">-</button>
                        <input type="number" min="1" value="${item.qty}" style="width: 60px; margin:0; padding:8px 5px; border: 1px solid var(--border); border-radius: 8px; text-align: center; font-weight:600;" onchange="updateCartItemQty('${item.cartId}', this.value)">
                        <button class="btn-qty" onclick="changeCartQty('${item.cartId}', 1)">+</button>
                        <button class="btn-outline btn-small" onclick="removeCartItem('${item.cartId}')" style="margin-left: 15px; border-color:var(--danger); color:var(--danger);">Remove</button>
                    </div>
                </td>
                <td style="color:var(--text-light);">₱${item.price.toFixed(2)}</td>
                <td style="color:var(--secondary);"><strong>₱${lineTotal.toFixed(2)}</strong></td>
            </tr>`;
        });
        document.getElementById("cart-subtotal").innerText = subtotal.toFixed(2); showSection("cart-section");
    }

    function changeCartQty(cartId, amount) {
        const cartItem = cart.find(c => c.cartId === cartId); if (!cartItem) return;
        const inventoryItem = inventory.find(i => i.id === cartItem.originalId);
        
        if (amount > 0) {
            const totalInCart = cart.filter(c => c.originalId === inventoryItem.id).reduce((sum, c) => sum + c.qty, 0);
            if (totalInCart + amount > inventoryItem.stock) return alert(`Cannot exceed total inventory of ${inventoryItem.stock}.`);
            cartItem.qty += amount;
        } else { 
            cartItem.qty += amount; 
            if (cartItem.qty <= 0) cart = cart.filter(c => c.cartId !== cartId); 
        }
        updateCartCount(); viewCart();
    }

    function updateCartItemQty(cartId, newQtyVal) {
        let newQty = parseInt(newQtyVal);
        if (isNaN(newQty) || newQty <= 0) return alert("Please enter a valid quantity.");
        
        const cartItem = cart.find(c => c.cartId === cartId);
        if (!cartItem) return;
        
        const inventoryItem = inventory.find(i => i.id === cartItem.originalId);
        const otherCartItemsQty = cart.filter(c => c.originalId === inventoryItem.id && c.cartId !== cartId).reduce((sum, c) => sum + c.qty, 0);
        
        if (otherCartItemsQty + newQty > inventoryItem.stock) {
            alert(`Cannot exceed total inventory of ${inventoryItem.stock}. You can only add ${inventoryItem.stock - otherCartItemsQty} more of this item.`);
            viewCart(); 
            return;
        }
        cartItem.qty = newQty; updateCartCount(); viewCart();
    }

    function removeCartItem(cartId) { cart = cart.filter(c => c.cartId !== cartId); updateCartCount(); viewCart(); }
    function backToShop() { showSection("user-section"); }

    function checkAvailabilityAndProceed() {
        if (cart.length === 0) return alert("Your cart is empty.");
        
        const dateInput = document.getElementById("reservation-date").value;
        const addressInput = document.getElementById("venue-address").value.trim();
        const deliveryMethod = document.getElementById("delivery-method").value;
        const paymentMode = document.getElementById("payment-mode").value;
        
        if (!dateInput) return alert("Please select your event date.");
        if (deliveryMethod === "delivery" && !addressInput) return alert("Please provide the full venue address for delivery.");
        
        const dateBookings = bookingsDb[dateInput] || {};
        for (let cartItem of cart) {
            const totalQtyInCart = cart.filter(c => c.originalId === cartItem.originalId).reduce((sum, c) => sum + c.qty, 0);
            const bookedQty = dateBookings[cartItem.originalId] || 0;
            const invItem = inventory.find(i => i.id === cartItem.originalId);
            const availableStock = invItem.stock - bookedQty;
            if (totalQtyInCart > availableStock) return alert(`For ${dateInput}, we only have ${availableStock}x ${invItem.name} remaining.`);
        }
        
        selectedEventDate = dateInput; 
        selectedAddress = deliveryMethod === "pickup" ? "" : addressInput;
        selectedDeliveryFee = deliveryMethod === "pickup" ? 0 : 300;
        selectedLogistics = deliveryMethod === "pickup" ? "Store Pick-up" : "Delivery";
        selectedPaymentMode = paymentMode === "cash" ? "Cash" : "Online Payment (InstaPay)";
        
        document.getElementById("display-event-date").innerText = selectedEventDate;
        document.getElementById("policy-checkbox").checked = false; 
        document.getElementById("btn-submit-reservation").disabled = true;
        showSection("policy-section");
    }

    function toggleSubmitButton() { document.getElementById("btn-submit-reservation").disabled = !document.getElementById("policy-checkbox").checked; }
    function cancelReservation() { showSection("cart-section"); }

    function finalizeReservation() {
        if(!bookingsDb[selectedEventDate]) bookingsDb[selectedEventDate] = {};
        cart.forEach(item => bookingsDb[selectedEventDate][item.originalId] = (bookingsDb[selectedEventDate][item.originalId] || 0) + item.qty );
        
        let itemSubtotal = cart.reduce((sum, i) => sum + (i.price * i.qty), 0);
        let grandTotal = itemSubtotal + selectedDeliveryFee;
        let downpayment = grandTotal / 2;
        
        allReservations.push({
            id: Date.now(), 
            renter: currentUser, 
            date: selectedEventDate,
            logistics: selectedLogistics,
            address: selectedAddress,
            deliveryFee: selectedDeliveryFee,
            paymentMode: selectedPaymentMode,
            items: JSON.parse(JSON.stringify(cart)), 
            total: grandTotal,
            status: "Pending Downpayment"
        });

        saveData();

        document.getElementById("receipt-name").innerText = currentUser;
        document.getElementById("receipt-email").innerText = currentUserEmail;
        document.getElementById("receipt-event-date").innerText = selectedEventDate;
        document.getElementById("receipt-logistics").innerText = selectedLogistics;
        document.getElementById("receipt-address").innerText = selectedAddress || "N/A (Client will Pick-up)";
        document.getElementById("receipt-downpayment").innerText = downpayment.toFixed(2);
        document.getElementById("receipt-date").innerText = new Date().toLocaleString();
        
        if (selectedPaymentMode === "Online Payment (InstaPay)") {
            document.getElementById("receipt-qr-area").style.display = "block";
            document.getElementById("receipt-cash-area").style.display = "none";
        } else {
            document.getElementById("receipt-qr-area").style.display = "none";
            document.getElementById("receipt-cash-area").style.display = "block";
        }
        
        let html = "<table style='width:100%; text-align:left; border-collapse: separate; border-spacing:0; margin-top:20px;'><tr style='border-bottom:2px solid var(--border);'><th style='background:transparent; color:var(--text-light);'>Item</th><th style='background:transparent; color:var(--text-light);'>Qty</th><th style='background:transparent; color:var(--text-light);'>Fee</th></tr>";
        cart.forEach(i => html += `<tr><td style="color:var(--secondary); font-weight:500;">${i.name}</td><td style="color:var(--text-light);">${i.qty}</td><td style="color:var(--text-light);">₱${(i.price * i.qty).toFixed(2)}</td></tr>`);
        
        if(selectedDeliveryFee > 0) {
            html += `<tr><td colspan='2' style='color:var(--text-light);'>Delivery Logistics</td><td style='color:var(--text-light);'>₱${selectedDeliveryFee.toFixed(2)}</td></tr>`;
        }
        
        html += `<tr><td colspan='2' style='font-size:1.3em; font-family: "Playfair Display", serif; padding-top:25px;'><b>Total Investment</b></td><td style='font-size:1.3em; color:var(--primary); padding-top:25px;'><b>₱${grandTotal.toFixed(2)}</b></td></tr></table>`;
        document.getElementById("receipt-content").innerHTML = html;
        showSection("receipt-section");
    }

    function downloadReceipt() {
        let text = "========================================\n        CHAIR WE GO! EVENT RENTALS      \n========================================\n\n";
        text += `Client Name: ${currentUser}\nEmail Address: ${currentUserEmail}\nEvent Date: ${selectedEventDate}\nLogistics: ${selectedLogistics}\nVenue: ${selectedAddress || "Pick-up"}\nPayment Mode: ${selectedPaymentMode}\nProcessed On: ${new Date().toLocaleString()}\n\n----------------------------------------\n`;
        
        let itemSubtotal = 0; 
        cart.forEach(i => { text += `${i.name} (x${i.qty}) \t\t ₱${(i.price * i.qty).toFixed(2)}\n`; itemSubtotal += (i.price * i.qty); });
        
        if(selectedDeliveryFee > 0) text += `Delivery Fee \t\t\t\t ₱${selectedDeliveryFee.toFixed(2)}\n`;
        
        let grandTotal = itemSubtotal + selectedDeliveryFee;
        let downpayment = grandTotal / 2;
        
        text += `----------------------------------------\nTOTAL BILL: \t\t\t ₱${grandTotal.toFixed(2)}\n`;
        text += `REQUIRED RETAINER (50%): \t ₱${downpayment.toFixed(2)}\n\n`;
        text += "*** IMPORTANT NOTE ***\nPlease pay your retainer fee within 3 days.\nFailure to remit will result in event cancellation.\n\nThank you for choosing Chair We GO!";
        
        const a = document.createElement("a"); a.href = URL.createObjectURL(new Blob([text], { type: "text/plain" }));
        a.download = `ChairWeGO_Invoice_${currentUser.replace(/\s+/g, '')}_${selectedEventDate}.txt`; a.click();
    }

    function finishOrder() { 
        cart = []; selectedEventDate = null; selectedAddress = null; selectedDeliveryFee = 0;
        document.getElementById("venue-address").value = ""; 
        document.getElementById("delivery-method").value = "pickup";
        document.getElementById("payment-mode").value = "cash";
        updateCartCount(); renderUser(); showSection("user-section"); 
    }

    // Expose functions to window
    window.showSection = showSection; window.goHome = goHome; window.getStarted = getStarted;
    window.switchAuth = switchAuth; window.signup = signup; window.login = login; window.logout = logout;
    window.switchAdminTab = switchAdminTab; window.addStock = addStock; window.showRenterDetails = showRenterDetails;
    window.changeAdminResStatus = changeAdminResStatus; window.deleteAdminReservation = deleteAdminReservation;
    window.changeMonth = changeMonth; window.showDateDetails = showDateDetails; window.closeAdminModal = closeAdminModal;
    window.triggerCoverModal = triggerCoverModal; window.resolveCover = resolveCover; window.viewCart = viewCart;
    window.changeCartQty = changeCartQty; window.updateCartItemQty = updateCartItemQty; window.removeCartItem = removeCartItem;
    window.backToShop = backToShop; window.checkAvailabilityAndProceed = checkAvailabilityAndProceed;
    window.toggleSubmitButton = toggleSubmitButton; window.cancelReservation = cancelReservation;
    window.finalizeReservation = finalizeReservation; window.downloadReceipt = downloadReceipt; window.finishOrder = finishOrder;
    window.toggleChatWidget = toggleChatWidget; window.sendChatMessage = sendChatMessage; window.sendChatImage = sendChatImage; window.handleChatEnter = handleChatEnter;

    showSection('landing-section');
</script>
</body>
</html>
