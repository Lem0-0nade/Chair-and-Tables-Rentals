<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chair We GO! - Premium Event Rentals</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,500&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #b45309; 
            --primary-hover: #92400e;
            --secondary: #1e293b; 
            --bg-color: #faf9f6; 
            --card-bg: #ffffff;
            --text-main: #334155;
            --text-light: #64748b;
            --border: #e2e8f0;
            --success: #15803d; 
            --danger: #be123c; 
            --danger-hover: #9f1239;
        }
        
        * { box-sizing: border-box; }
        body { 
            font-family: 'Poppins', sans-serif; 
            background-color: var(--bg-color); 
            color: var(--text-main); 
            margin: 0; 
            padding: 20px; 
            background-image: radial-gradient(#e2e8f0 1px, transparent 1px);
            background-size: 40px 40px;
        }
        .container { max-width: 1050px; margin: 0 auto; padding-bottom: 80px; }
        
        h1, h2, h3 { font-family: 'Playfair Display', serif; color: var(--secondary); }
        
        .header { 
            text-align: center; margin-bottom: 30px; padding: 30px 20px; 
            background: var(--card-bg); border-radius: 16px; 
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05); 
            border-top: 4px solid var(--primary);
        }
        .header h1 { color: var(--secondary); font-size: 3.2em; margin: 0 0 5px 0; font-weight: 700; cursor: pointer; letter-spacing: -0.5px;}
        .header h1 span { color: var(--primary); font-style: italic; }
        .header p { color: var(--text-light); font-size: 1.1em; margin: 0; text-transform: uppercase; letter-spacing: 2px; font-size: 0.85em; font-weight: 500;}
        
        .section { display: none; background: var(--card-bg); padding: 45px; border-radius: 16px; box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.05); animation: fadeIn 0.5s cubic-bezier(0.16, 1, 0.3, 1); }
        .active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

        .landing-hero { 
            text-align: center; padding: 70px 30px; 
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            border-radius: 16px; color: white;
            box-shadow: 0 20px 40px -10px rgba(30, 41, 59, 0.4);
            position: relative; overflow: hidden;
        }
        .landing-hero::before {
            content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 60%);
            animation: rotate 30s linear infinite;
        }
        @keyframes rotate { 100% { transform: rotate(360deg); } }
        .landing-hero h2 { font-size: 3em; color: #fef08a; margin-bottom: 15px; position: relative; z-index: 1; }
        .landing-hero p { font-size: 1.15em; color: #cbd5e1; margin-bottom: 40px; max-width: 600px; margin-left: auto; margin-right: auto; position: relative; z-index: 1; line-height: 1.6;}
        .landing-buttons { display: flex; justify-content: center; gap: 20px; position: relative; z-index: 1;}
        
        #auth-section { background: transparent; box-shadow: none; padding: 0; }
        .auth-card { background: var(--card-bg); max-width: 420px; margin: 0 auto; padding: 45px; border-radius: 16px; box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.08); border: 1px solid var(--border); }
        .auth-card h2 { text-align: center; margin-top: 0; color: var(--secondary); font-size: 2.2em; margin-bottom: 30px; }
        .auth-msg { color: var(--danger); font-size: 0.9em; margin-top: 15px; text-align: center; }
        .auth-msg.success { color: var(--success); }

        input[type="text"], input[type="password"], input[type="email"], input[type="number"], input[type="date"], select { 
            padding: 15px; margin-bottom: 20px; width: 100%; border-radius: 8px; border: 1px solid var(--border); font-size: 15px; font-family: 'Poppins', sans-serif; transition: all 0.3s;
            background-color: #f8fafc;
        }
        input:focus, select:focus { outline: none; border-color: var(--primary); background-color: #fff; box-shadow: 0 0 0 3px rgba(180, 83, 9, 0.1); }
        
        button { 
            background-color: var(--primary); color: white; border: none; cursor: pointer; font-weight: 500; 
            padding: 15px 25px; border-radius: 30px; font-size: 15px; width: 100%; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); font-family: 'Poppins', sans-serif; letter-spacing: 0.5px;
        }
        button:hover:not(:disabled) { background-color: var(--primary-hover); transform: translateY(-2px); box-shadow: 0 10px 20px -10px var(--primary); }
        button:disabled { background-color: #cbd5e1; cursor: not-allowed; transform: none; box-shadow: none;}
        
        .btn-success { background-color: var(--primary); }
        .btn-danger { background-color: var(--danger); }
        .btn-danger:hover:not(:disabled) { background-color: var(--danger-hover); box-shadow: 0 10px 20px -10px var(--danger);}
        .btn-outline { background-color: transparent; border: 2px solid var(--secondary); color: var(--secondary); }
        .btn-outline:hover { background-color: var(--secondary); color: white; box-shadow: 0 10px 20px -10px var(--secondary);}
        .btn-hero-outline { background-color: transparent; border: 2px solid #fef08a; color: #fef08a; }
        .btn-hero-outline:hover { background-color: #fef08a; color: var(--secondary); }
        .btn-small { padding: 8px 15px; font-size: 0.9em; border-radius: 20px; width: auto; }

        .toggle-link { color: var(--primary); text-align: center; display: block; cursor: pointer; font-size: 0.95em; font-weight: 500; margin-top: 15px; transition: color 0.3s;}
        .toggle-link:hover { color: var(--primary-hover); text-decoration: underline; }
        
        .nav-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 35px; border-bottom: 1px solid var(--border); padding-bottom: 20px; }
        .nav-bar h2 { margin: 0; font-size: 2em; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px; }
        
        .admin-tabs { display: flex; gap: 15px; margin-bottom: 30px; border-bottom: 1px solid var(--border); padding-bottom: 20px; }
        .admin-tab-btn { background: transparent; color: var(--text-light); border: none; padding: 12px 25px; font-size: 1.05em; cursor: pointer; border-radius: 30px; width: auto; font-weight: 500; }
        .admin-tab-btn.active-tab { background: var(--secondary); color: white; box-shadow: 0 8px 15px -5px rgba(30, 41, 59, 0.3); }
        .admin-view { display: none; }
        .admin-view.active-view { display: block; animation: fadeIn 0.4s ease-in-out; }

        .cal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
        .cal-days { display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; font-weight: 600; color: var(--text-light); margin-bottom: 15px; font-size: 0.9em; text-transform: uppercase; letter-spacing: 1px;}
        .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; }
        .cal-cell { min-height: 90px; border: 1px solid var(--border); border-radius: 8px; padding: 12px; cursor: pointer; transition: all 0.2s; background: white; text-align: right; font-weight: 500;}
        .cal-cell:hover { background: var(--bg-color); border-color: var(--primary); transform: translateY(-2px); box-shadow: 0 5px 15px -5px rgba(0,0,0,0.05); }
        .cal-cell.empty { background: transparent; border: none; cursor: default; box-shadow: none; transform: none;}
        .cal-cell.has-booking { background: #fffbeb; border-color: #fde68a; }
        .booking-badge { background: var(--primary); color: white; font-size: 0.75em; padding: 4px 10px; border-radius: 12px; display: inline-block; float: left; margin-top: -2px; font-weight: 600;}

        .card { border: 1px solid var(--border); padding: 0; border-radius: 16px; text-align: center; background: #fff; transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); position: relative; overflow: hidden; }
        .card:hover { transform: translateY(-10px); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1); border-color: var(--primary); }
        .card img { width: 100%; height: 220px; object-fit: cover; border-bottom: 1px solid var(--border); transition: transform 0.6s ease; }
        .card:hover img { transform: scale(1.05); } 
        .card-content { padding: 25px; background: white; position: relative; z-index: 2; }
        .card h3 { margin: 0 0 10px 0; font-size: 1.4em; }
        .item-desc { max-height: 0; opacity: 0; overflow: hidden; transition: all 0.5s ease; margin: 0; font-size: 0.9em; color: var(--text-light); }
        .card:hover .item-desc { max-height: 150px; opacity: 1; margin-bottom: 20px; margin-top: 10px; }
        .price-tag { font-size: 1.25em; font-weight: 600; color: var(--primary); margin-bottom: 20px; display: block; font-family: 'Playfair Display', serif;}
        
        .table-responsive { width: 100%; overflow-x: auto; }
        table { width: 100%; min-width: 600px; border-collapse: separate; border-spacing: 0; margin-top: 15px; }
        th, td { border-bottom: 1px solid var(--border); padding: 18px 15px; text-align: left; vertical-align: middle; }
        th { background-color: #f8fafc; color: var(--text-light); font-weight: 600; text-transform: uppercase; font-size: 0.8em; letter-spacing: 1px; }
        th:first-child { border-top-left-radius: 8px; } th:last-child { border-top-right-radius: 8px; }
        .btn-qty { background: var(--bg-color); border: 1px solid var(--border); color: var(--secondary); padding: 5px 12px; border-radius: 20px; width: auto; font-size: 1.2em; }

        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.7); display: none; justify-content: center; align-items: center; z-index: 1000; backdrop-filter: blur(5px); }
        .modal { background: #fff; padding: 40px; border-radius: 16px; max-width: 600px; width: 90%; max-height: 85vh; overflow-y: auto; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); animation: popIn 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
        @keyframes popIn { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }
        .modal h3 { margin-top: 0; font-size: 1.8em; border-bottom: 1px solid var(--border); padding-bottom: 15px; }
        .modal-buttons { display: flex; gap: 15px; margin-top: 25px; }
        .detail-box { background: #f8fafc; border: 1px solid var(--border); padding: 20px; border-radius: 12px; margin-bottom: 15px; text-align: left; position: relative; transition: all 0.3s;}
        .detail-box:hover { border-color: var(--primary); box-shadow: 0 10px 20px -10px rgba(0,0,0,0.05); }

        .date-picker-box { background: #f8fafc; padding: 30px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 30px; display: flex; align-items: flex-start; gap: 25px; flex-wrap: wrap;}
        .date-picker-box label { font-weight: 500; color: var(--secondary); font-size: 0.95em; }
        .policy-box { background: #f8fafc; border: 1px solid var(--border); padding: 25px; border-radius: 12px; height: 200px; overflow-y: auto; margin-bottom: 25px; font-size: 0.95em; line-height: 1.8; color: var(--text-main); }
        .checkbox-container { display: flex; align-items: center; gap: 15px; margin-bottom: 30px; font-weight: 500; font-size: 1.05em; cursor: pointer; color: var(--secondary); }
        .checkbox-container input { width: 24px; height: 24px; cursor: pointer; accent-color: var(--primary); }

        .status-badge { display: inline-block; padding: 6px 15px; border-radius: 20px; font-size: 0.75em; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 12px; }
        .status-pending { background-color: #fef3c7; color: #d97706; border: 1px solid #fde68a; }
        .status-paid { background-color: #d1fae5; color: #059669; border: 1px solid #a7f3d0; }

        /* Notification Toast */
        #toast-container { position: fixed; top: 20px; right: 20px; z-index: 2000; display: flex; flex-direction: column; gap: 10px; }
        .toast { background: var(--secondary); color: white; padding: 15px 25px; border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); animation: slideIn 0.3s forwards; font-size: 0.9em; display: flex; align-items: center; justify-content: space-between; gap: 15px;}
        @keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
        
        /* Chat Widget Styles */
        #chat-widget { position: fixed; bottom: 20px; right: 20px; width: 380px; background: white; border-radius: 16px; box-shadow: 0 15px 35px rgba(0,0,0,0.2); z-index: 1500; display: none; flex-direction: column; overflow: hidden; border: 1px solid var(--border); }
        #chat-header { background: var(--secondary); color: white; padding: 15px 20px; font-weight: 600; display: flex; justify-content: space-between; align-items: center; cursor: pointer; font-family: 'Playfair Display', serif; font-size: 1.1em;}
        #chat-body { display: flex; height: 360px; background: #f8fafc; }
        #admin-chat-list { width: 35%; background: white; border-right: 1px solid var(--border); overflow-y: auto; display: none; }
        .chat-list-user { padding: 12px 10px; border-bottom: 1px solid var(--border); cursor: pointer; font-size: 0.85em; font-weight: 500; color: var(--text-main); transition: background 0.2s;}
        .chat-list-user:hover, .chat-list-user.active { background: #eff6ff; color: var(--primary); }
        .chat-list-user.unread { font-weight: 700; color: var(--danger); }
        #chat-messages { flex: 1; padding: 15px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; }
        .msg-bubble { max-width: 80%; padding: 10px 15px; border-radius: 12px; font-size: 0.9em; line-height: 1.4; }
        .msg-client { background: white; border: 1px solid var(--border); align-self: flex-start; border-bottom-left-radius: 2px;}
        .msg-admin { background: var(--primary); color: white; align-self: flex-end; border-bottom-right-radius: 2px;}
        #chat-input-area { padding: 12px 15px; background: white; border-top: 1px solid var(--border); display: flex; gap: 8px; align-items: center; }
        #chat-input-area input[type="text"] { margin: 0; padding: 10px 15px; border-radius: 20px; border: 1px solid var(--border); width: 100%; font-size: 0.9em;}
        #chat-input-area button { width: auto; padding: 10px 18px; border-radius: 20px; font-size: 0.9em;}

        #chat-toggle-btn { position: fixed; bottom: 20px; right: 20px; background: var(--primary); color: white; width: 60px; height: 60px; border-radius: 50%; display: none; justify-content: center; align-items: center; font-size: 1.5em; cursor: pointer; box-shadow: 0 10px 20px rgba(180, 83, 9, 0.3); z-index: 1400; border: none; transition: transform 0.2s;}
        #chat-toggle-btn:hover { transform: scale(1.1); }
        
        /* Mobile Responsiveness */
        @media (max-width: 768px) {
            body { padding: 10px; }
            .header h1 { font-size: 2.2em; }
            .landing-hero { padding: 40px 20px; }
            .landing-hero h2 { font-size: 2em; }
            .landing-buttons { flex-direction: column; width: 100%; }
            .landing-buttons button { width: 100%; }
            
            .section { padding: 25px 15px; }
            .nav-bar { flex-direction: column; gap: 15px; text-align: center; }
            .nav-bar h2 { font-size: 1.5em; }
            .nav-bar div { width: 100%; justify-content: center; flex-wrap: wrap; }
            
            .date-picker-box { flex-direction: column; gap: 15px; padding: 20px; }
            .date-picker-box > div { width: 100% !important; min-width: 100%; }
            
            .admin-tabs { flex-wrap: wrap; justify-content: center; }
            .admin-tab-btn { width: 100%; text-align: center; margin-bottom: 5px; }
            
            .cal-cell { min-height: 60px; padding: 5px; font-size: 0.85em; }
            .modal { width: 95%; padding: 25px 15px; }
            .modal-buttons { flex-direction: column; }
            .modal-buttons button { width: 100% !important; }
            
            #chat-widget { width: 92%; right: 4%; bottom: 90px; height: 60vh; }
            #chat-body { height: calc(100% - 120px); }
        }

        @media print {
            body * { visibility: hidden; background: white; }
            #receipt-section, #receipt-section * { visibility: visible; }
            #receipt-section { position: absolute; left: 0; top: 0; width: 100%; box-shadow: none; padding: 0;}
            .no-print, #chat-widget, #chat-toggle-btn { display: none !important; }
        }
    </style>
</head>
<body>

<div id="toast-container"></div>

<div class="container">
    <div class="header">
        <h1 onclick="goHome()">Chair We <span>GO!</span></h1>
        <p>Premium Seating & Tables for Discerning Events</p>
    </div>

    <!-- LANDING PAGE SECTION -->
    <div id="landing-section" class="section active">
        <div class="landing-hero">
            <h2>Set the Stage for an Unforgettable Gathering</h2>
            <p>From intimate backyard celebrations to grand formal banquets, we provide pristine, high-quality seating and dining tables delivered right to your venue.</p>
            
            <div class="landing-buttons">
                <button class="btn-success" style="width: auto; padding: 15px 45px; font-size: 1.1em;" onclick="getStarted('signup')">Reserve Now</button>
                <button class="btn-hero-outline" style="width: auto; padding: 15px 45px; font-size: 1.1em; border-radius: 30px; font-weight: 500; cursor: pointer; font-family: 'Poppins', sans-serif;" onclick="getStarted('login')">Client Log In</button>
            </div>
        </div>

        <div class="grid" style="margin-top: 30px;">
            <div class="detail-box" style="text-align: center; background: white; border: none; box-shadow: 0 10px 30px -10px rgba(0,0,0,0.05);">
                <h3 style="color: var(--primary); margin-top: 0; font-size: 2em; margin-bottom: 5px;">✦</h3>
                <h3 style="color: var(--secondary); margin: 10px 0; font-size: 1.3em;">Pristine Quality</h3>
                <p style="color: var(--text-light); font-size: 0.95em;">Carefully inspected and sanitized inventory ensuring your event styling looks absolutely flawless.</p>
            </div>
            <div class="detail-box" style="text-align: center; background: white; border: none; box-shadow: 0 10px 30px -10px rgba(0,0,0,0.05);">
                <h3 style="color: var(--primary); margin-top: 0; font-size: 2em; margin-bottom: 5px;">✧</h3>
                <h3 style="color: var(--secondary); margin: 10px 0; font-size: 1.3em;">Flexible Logistics</h3>
                <p style="color: var(--text-light); font-size: 0.95em;">Choose between complimentary store pick-up or professional direct-to-venue delivery.</p>
            </div>
            <div class="detail-box" style="text-align: center; background: white; border: none; box-shadow: 0 10px 30px -10px rgba(0,0,0,0.05);">
                <h3 style="color: var(--primary); margin-top: 0; font-size: 2em; margin-bottom: 5px;">✦</h3>
                <h3 style="color: var(--secondary); margin: 10px 0; font-size: 1.3em;">Seamless Booking</h3>
                <p style="color: var(--text-light); font-size: 0.95em;">Secure your dates elegantly via our 24/7 cloud-synced concierge reservation portal.</p>
            </div>
        </div>
    </div>

    <!-- AUTHENTICATION SECTION -->
    <div id="auth-section" class="section">
        <div class="auth-card" id="signup-view">
            <h2>Create an Account</h2>
            <input type="text" id="signup-name" placeholder="Full Name">
            <input type="email" id="signup-email" placeholder="Email Address">
            <input type="password" id="signup-pass" placeholder="Password">
            <button class="btn-success" onclick="signup()">Register to Rent</button>
            <a class="toggle-link" onclick="switchAuth('login')">Already a client? Log in</a>
            <p id="signup-msg" class="auth-msg"></p>
        </div>

        <div class="auth-card" id="login-view" style="display: none;">
            <h2>Welcome Back</h2>
            <input type="text" id="login-identifier" placeholder="Email Address or Full Name">
            <input type="password" id="login-pass" placeholder="Password">
            <button onclick="login()">Access Portal</button>
            <a class="toggle-link" onclick="switchAuth('signup')">New client? Register here</a>
            <p id="login-msg" class="auth-msg"></p>
        </div>
    </div>

    <!-- ADMIN SECTION -->
    <div id="admin-section" class="section">
        <div class="nav-bar">
            <h2>Admin Dashboard</h2>
            <button class="btn-danger btn-small" onclick="logout()">Secure Logout</button>
        </div>

        <div class="admin-tabs">
            <button class="admin-tab-btn active-tab" id="tab-inventory" onclick="switchAdminTab('inventory')">Inventory</button>
            <button class="admin-tab-btn" id="tab-renters" onclick="switchAdminTab('renters')">Client Records</button>
            <button class="admin-tab-btn" id="tab-calendar" onclick="switchAdminTab('calendar')">Event Calendar</button>
        </div>

        <div id="admin-inventory" class="admin-view active-view">
            <div class="date-picker-box">
                <div style="flex:1;">
                    <label>Add Stock Capacity</label>
                    <input type="text" id="add-name" placeholder="Exact Item Name" style="margin-bottom:0; margin-top:10px;">
                </div>
                <div style="width: 150px;">
                    <label>Quantity</label>
                    <input type="number" id="add-qty" placeholder="Qty" style="margin-bottom:0; margin-top:10px;">
                </div>
                <div style="width: 150px; align-self: flex-end;">
                    <button class="btn-success" onclick="addStock()">Update Stock</button>
                </div>
            </div>
            <div class="table-responsive">
                <table id="inventory-table">
                    <thead><tr><th>Rental Item</th><th>Description</th><th>Max Capacity</th><th>Daily Rate</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <div id="admin-renters" class="admin-view">
            <div class="table-responsive">
                <table id="renters-table">
                    <thead><tr><th>Client Name</th><th>Total Events</th><th>Actions</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <div id="admin-calendar" class="admin-view">
            <div class="cal-header">
                <button class="btn-outline btn-small" onclick="changeMonth(-1)">&#8592; Prev</button>
                <h3 id="cal-month-year" style="margin:0; font-size: 1.8em;"></h3>
                <button class="btn-outline btn-small" onclick="changeMonth(1)">Next &#8594;</button>
            </div>
            <div class="cal-days">
                <div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div>
            </div>
            <div class="cal-grid" id="cal-grid"></div>
        </div>
    </div>

    <!-- USER RENTAL CATALOG -->
    <div id="user-section" class="section">
        <div class="nav-bar">
            <h2>Welcome, <span id="display-renter-name" style="color:var(--primary); font-family: 'Playfair Display', serif; font-style: italic;"></span></h2>
            <div style="display: flex; gap: 15px;">
                <button class="btn-success btn-small" onclick="viewCart()">Cart (<span id="cart-count">0</span>)</button>
                <button class="btn-outline btn-small" onclick="logout()">Logout</button>
            </div>
        </div>
        <p style="color: var(--text-light); margin-bottom: 30px; font-size: 1.1em;">Curate your event by selecting from our premium inventory below.</p>
